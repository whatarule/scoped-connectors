{
  "display_information": {
    "name": "Scoped Connector",
    "description": "AIエージェントから、範囲を限定してメッセージの読み取りと投稿を行うためのアプリ"
  },
  "oauth_config": {
    "redirect_urls": [
      "http://localhost:53682/slack/oauth/callback"
    ],
    "scopes": {
      "user": [
        "channels:history",
        "channels:read",
        "chat:write",
        "search:read.public",
        "users:read",
        "usergroups:read"
      ],
      "user_optional": [
        "chat:write"
      ]
    },
    "pkce_enabled": true
  },
  "settings": {
    "token_rotation_enabled": true
  }
}
